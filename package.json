{
  "name": "inview-mvp",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "dotenv -- node server.js",
    "build": "react-router build",
    "start": "NODE_ENV=production node server.js",
    "typecheck": "react-router typegen && tsc -b",
    "db:generate": "dotenv -- drizzle-kit generate",
    "db:migrate": "dotenv -- node scripts/migrate.mjs",
    "db:seed": "dotenv -- tsx scripts/seed.ts",
    "db:migrate:prod": "node scripts/migrate.mjs",
    "test": "tsx --test server/*.test.ts",
    "test:e2e": "playwright test",
    "ci": "npm run test && npm run typecheck && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@fontsource/archivo": "^5.0.0",
    "@fontsource/instrument-serif": "^5.0.0",
    "@fontsource/vazirmatn": "^5.0.0",
    "@react-router/express": "^7.5.3",
    "@react-router/node": "^7.5.3",
    "compression": "^1.8.0",
    "drizzle-orm": "^0.39.3",
    "express": "^5.1.0",
    "isbot": "^5.1.27",
    "morgan": "^1.10.0",
    "postgres": "^3.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.5.3",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@playwright/test": "^1.64.1",
    "@react-router/dev": "^7.5.3",
    "@types/compression": "^1.7.5",
    "@types/express": "^5.0.1",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.13.10",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "dotenv-cli": "^8.0.0",
    "drizzle-kit": "^0.30.4",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "vite": "^6.3.3",
    "vite-plugin-pwa": "^0.21.1",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
